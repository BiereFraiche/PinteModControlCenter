{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pintemod.invalid/contracts/control-center/v1/server_identity.schema.json",
  "title": "PinteMod Control Center server identity v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "session_id", "sequence", "generated_gettime",
    "updated_at_utc", "time_authority", "public_hostname",
    "public_hostname_state",
    "join_password_enabled", "revision"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "session_id": { "type": "string", "minLength": 1, "maxLength": 96 },
    "sequence": { "type": "integer", "minimum": 0, "maximum": 999999999999 },
    "generated_gettime": { "type": "integer", "minimum": 0, "maximum": 999999999999 },
    "updated_at_utc": { "const": "" },
    "time_authority": { "const": "session_gettime_and_file_mtime" },
    "public_hostname": {
      "type": "string",
      "maxLength": 96,
      "pattern": "^[A-Za-z0-9 ._\\[\\]()-]*$"
    },
    "public_hostname_state": { "enum": ["observed", "neutralized", "empty"] },
    "join_password_enabled": { "type": "boolean" },
    "revision": { "type": "integer", "minimum": 1, "maximum": 999999999999 }
  }
}
