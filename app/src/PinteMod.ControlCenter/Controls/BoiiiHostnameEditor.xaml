<UserControl x:Class="PinteMod.ControlCenter.Controls.BoiiiHostnameEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore">
    <UserControl.Resources>
        <Style x:Key="HostnameColorButtonStyle" TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
            <Setter Property="Width" Value="42" />
            <Setter Property="Height" Value="31" />
            <Setter Property="Padding" Value="3" />
            <Setter Property="Margin" Value="0,0,5,5" />
            <Setter Property="FontSize" Value="9" />
        </Style>
    </UserControl.Resources>

    <StackPanel>
        <TextBox x:Name="EncodedTextBox"
                 MaxLength="64"
                 TextChanged="EncodedTextBox_TextChanged"
                 Background="{StaticResource SurfaceHoverBrush}"
                 BorderBrush="{DynamicResource AccentBrush}"
                 automation:AutomationProperties.Name="Nom public BOIII avec codes couleur"
                 ToolTip="Le texte transmis reste limité à 64 caractères, codes ^0 à ^9 compris." />

        <TextBlock Text="COULEUR À INSÉRER" Style="{StaticResource EyebrowTextStyle}" Margin="0,9,0,6" />
        <WrapPanel>
            <Button Tag="0" ToolTip="^0 · Noir" Click="ColorButton_Click" Style="{StaticResource HostnameColorButtonStyle}">
                <StackPanel Orientation="Horizontal"><Ellipse Width="13" Height="13" Fill="#111111" Stroke="#8B96A5" StrokeThickness="1" /><TextBlock Text="^0" Margin="4,0,0,0" /></StackPanel>
            </Button>
            <Button Tag="1" ToolTip="^1 · Rouge" Click="ColorButton_Click" Style="{StaticResource HostnameColorButtonStyle}">
                <StackPanel Orientation="Horizontal"><Ellipse Width="13" Height="13" Fill="#FF4B4B" /><TextBlock Text="^1" Margin="4,0,0,0" /></StackPanel>
            </Button>
            <Button Tag="2" ToolTip="^2 · Vert" Click="ColorButton_Click" Style="{StaticResource HostnameColorButtonStyle}">
                <StackPanel Orientation="Horizontal"><Ellipse Width="13" Height="13" Fill="#4DDB7D" /><TextBlock Text="^2" Margin="4,0,0,0" /></StackPanel>
            </Button>
            <Button Tag="3" ToolTip="^3 · Jaune" Click="ColorButton_Click" Style="{StaticResource HostnameColorButtonStyle}">
                <StackPanel Orientation="Horizontal"><Ellipse Width="13" Height="13" Fill="#FFD447" /><TextBlock Text="^3" Margin="4,0,0,0" /></StackPanel>
            </Button>
            <Button Tag="4" ToolTip="^4 · Bleu" Click="ColorButton_Click" Style="{StaticResource HostnameColorButtonStyle}">
                <StackPanel Orientation="Horizontal"><Ellipse Width="13" Height="13" Fill="#4EA1FF" /><TextBlock Text="^4" Margin="4,0,0,0" /></StackPanel>
            </Button>
            <Button Tag="5" ToolTip="^5 · Cyan" Click="ColorButton_Click" Style="{StaticResource HostnameColorButtonStyle}">
                <StackPanel Orientation="Horizontal"><Ellipse Width="13" Height="13" Fill="#40E0E0" /><TextBlock Text="^5" Margin="4,0,0,0" /></StackPanel>
            </Button>
            <Button Tag="6" ToolTip="^6 · Rose" Click="ColorButton_Click" Style="{StaticResource HostnameColorButtonStyle}">
                <StackPanel Orientation="Horizontal"><Ellipse Width="13" Height="13" Fill="#FF6AD5" /><TextBlock Text="^6" Margin="4,0,0,0" /></StackPanel>
            </Button>
            <Button Tag="7" ToolTip="^7 · Blanc" Click="ColorButton_Click" Style="{StaticResource HostnameColorButtonStyle}">
                <StackPanel Orientation="Horizontal"><Ellipse Width="13" Height="13" Fill="#F4F7FB" /><TextBlock Text="^7" Margin="4,0,0,0" /></StackPanel>
            </Button>
            <Button Tag="8" ToolTip="^8 · Équipe" Click="ColorButton_Click" Style="{StaticResource HostnameColorButtonStyle}">
                <StackPanel Orientation="Horizontal"><Ellipse Width="13" Height="13" Fill="#9AA7B5" /><TextBlock Text="^8" Margin="4,0,0,0" /></StackPanel>
            </Button>
            <Button Tag="9" ToolTip="^9 · Orange" Click="ColorButton_Click" Style="{StaticResource HostnameColorButtonStyle}">
                <StackPanel Orientation="Horizontal"><Ellipse Width="13" Height="13" Fill="#FF9F43" /><TextBlock Text="^9" Margin="4,0,0,0" /></StackPanel>
            </Button>
        </WrapPanel>

        <TextBlock Text="Cliquez une couleur puis écrivez, ou sélectionnez des lettres avant de choisir une couleur."
                   Foreground="{StaticResource TextMutedBrush}" FontSize="9" TextWrapping="Wrap" />

        <Border Background="#4C5866" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1"
                CornerRadius="5" Padding="10,8" Margin="0,9,0,0">
            <StackPanel>
                <TextBlock Text="APERÇU DIRECT · COULEURS INDICATIVES" Foreground="#D9E2EC"
                           FontSize="8" FontWeight="SemiBold" Margin="0,0,0,5" />
                <TextBlock x:Name="PreviewTextBlock" FontSize="16" FontWeight="SemiBold"
                           TextWrapping="Wrap" automation:AutomationProperties.Name="Aperçu coloré du nom BOIII" />
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
