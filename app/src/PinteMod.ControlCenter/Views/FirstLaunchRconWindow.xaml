<Window x:Class="PinteMod.ControlCenter.Views.FirstLaunchRconWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Premier démarrage · RCON"
        Width="560" SizeToContent="Height" MinHeight="360"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource AppBackgroundBrush}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Text="PREMIER DÉMARRAGE" Style="{StaticResource SectionTitleStyle}" />
        <TextBlock Grid.Row="1" Margin="0,8,0,18" TextWrapping="Wrap"
                   Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" LineHeight="18"
                   Text="Définissez maintenant le premier mot de passe RCON pour un serveur vierge. S’il existe déjà, ne le remplacez pas : démarrez le serveur puis enregistrez ce même mot de passe dans Paramètres. Le mot de passe est protégé par Windows et ne sera jamais réaffiché." />
        <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="14">
            <StackPanel>
                <TextBlock Text="MOT DE PASSE RCON" Style="{StaticResource EyebrowTextStyle}" />
                <PasswordBox x:Name="RconPasswordBox" MaxLength="128" Margin="0,7,0,12"
                             ToolTip="8 à 128 caractères, sans espace ni guillemet." />
                <TextBlock Text="CONFIRMER LE MOT DE PASSE" Style="{StaticResource EyebrowTextStyle}" />
                <PasswordBox x:Name="ConfirmPasswordBox" MaxLength="128" Margin="0,7,0,0"
                             ToolTip="Saisissez exactement le même mot de passe." />
            </StackPanel>
        </Border>
        <TextBlock x:Name="ValidationText" Grid.Row="3" Margin="0,12,0,0"
                   Foreground="{StaticResource WarningBrush}" FontSize="11" TextWrapping="Wrap" />
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="ANNULER" Style="{StaticResource SecondaryButtonStyle}" Padding="12,7" Margin="0,0,8,0" IsCancel="True" />
            <Button Content="DÉMARRER SANS RCON" Style="{StaticResource SecondaryButtonStyle}" Padding="12,7" Margin="0,0,8,0" Click="StartWithoutRcon_Click" />
            <Button Content="ENREGISTRER ET DÉMARRER" Style="{StaticResource PrimaryButtonStyle}" Padding="12,7" Click="SaveAndStart_Click" />
        </StackPanel>
    </Grid>
</Window>
