{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pintemod.invalid/contracts/control-center/v1/map_transition.schema.json",
  "title": "PinteMod Control Center map transition v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "request_id", "action", "requested_map",
    "originating_session_id", "status", "result_code",
    "generated_gettime", "updated_at_utc", "time_authority"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "request_id": { "type": "string", "pattern": "^[A-Za-z0-9_-]{8,32}$" },
    "action": { "const": "restart_map" },
    "requested_map": { "type": "string", "pattern": "^zm_[a-z0-9_]+$", "maxLength": 32 },
    "originating_session_id": { "type": "string", "minLength": 1, "maxLength": 96 },
    "status": { "enum": ["accepted", "transitioning", "active", "failed"] },
    "result_code": {
      "enum": [
        "accepted", "transition_started", "success", "result_map_mismatch"
      ]
    },
    "generated_gettime": { "type": "integer", "minimum": 0, "maximum": 999999999999 },
    "updated_at_utc": { "const": "" },
    "time_authority": { "const": "session_gettime_and_file_mtime" },
    "resulting_session_id": { "type": "string", "minLength": 1, "maxLength": 96 }
  }
}
