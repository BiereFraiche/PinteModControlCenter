<Window x:Class="PinteMod.ControlCenter.Views.RemoteUpdateProgressWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="560" Height="230" WindowStartupLocation="CenterOwner" WindowStyle="None"
        ResizeMode="NoResize" Background="Transparent" AllowsTransparency="True" ShowInTaskbar="False">
    <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10">
        <Grid Margin="22">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <TextBlock Text="SYNCHRONISATION DU PC SERVEUR" FontSize="14" FontWeight="SemiBold"/>
            <TextBlock x:Name="StepText" Grid.Row="1" Margin="0,16,0,10" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Text="Préparation…"/>
            <Grid Grid.Row="2" Height="18">
                <Border Background="{StaticResource SurfaceAltBrush}" CornerRadius="9" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1"/>
                <ProgressBar x:Name="Progress" Minimum="0" Maximum="100" Value="0" Height="16" Margin="1" Foreground="{StaticResource SuccessBrush}" Background="Transparent" BorderThickness="0"/>
                <TextBlock x:Name="PercentText" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="9" FontWeight="Bold" Text="0 %"/>
            </Grid>
            <TextBlock Grid.Row="3" Margin="0,14,0,0" Foreground="{StaticResource TextMutedBrush}" FontSize="10" Text="Ne fermez pas le Control Center pendant cette opération."/>
        </Grid>
    </Border>
</Window>
