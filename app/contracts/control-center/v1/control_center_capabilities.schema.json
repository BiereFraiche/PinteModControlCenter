{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pintemod.invalid/contracts/control-center/v1/control_center_capabilities.schema.json",
  "title": "PinteMod Control Center capabilities v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "module_version", "contract_module_version",
    "command_contract_version", "session_id", "sequence",
    "generated_gettime", "updated_at_utc", "time_authority", "map_code",
    "map_source", "map_installation_authority", "map_count",
    "rotation_state", "rotation_entry_count", "change_map", "restart_map",
    "event_count", "boss_count", "power_up_count", "diagnostic_count",
    "transition_state", "set_hostname", "set_join_password",
    "clear_join_password", "join_password_transport", "map_profile",
    "power_support", "pack_a_punch_support", "event_support",
    "boss_support", "music_support", "dog_round_support",
    "active_pintemod_bosses", "max_pintemod_bosses"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "module_version": { "type": "string", "maxLength": 32 },
    "contract_module_version": { "enum": ["0.1.3", "0.1.4"] },
    "command_contract_version": { "const": 1 },
    "session_id": { "type": "string", "minLength": 1, "maxLength": 96 },
    "sequence": { "$ref": "#/$defs/nonNegativeInteger" },
    "generated_gettime": { "$ref": "#/$defs/nonNegativeInteger" },
    "updated_at_utc": { "const": "" },
    "time_authority": { "const": "session_gettime_and_file_mtime" },
    "map_code": { "type": "string", "minLength": 1, "maxLength": 32, "pattern": "^[a-z0-9_]+$" },
    "map_source": { "const": "runtime" },
    "map_installation_authority": { "const": "unknown" },
    "map_count": { "$ref": "#/$defs/nonNegativeInteger" },
    "rotation_state": { "const": "unknown" },
    "rotation_entry_count": { "const": 0 },
    "change_map": { "const": false },
    "restart_map": { "type": "boolean" },
    "event_count": { "$ref": "#/$defs/nonNegativeInteger" },
    "boss_count": { "$ref": "#/$defs/nonNegativeInteger" },
    "power_up_count": { "$ref": "#/$defs/nonNegativeInteger" },
    "diagnostic_count": { "$ref": "#/$defs/nonNegativeInteger" },
    "transition_state": { "enum": ["idle", "accepted", "transitioning", "active", "failed"] },
    "set_hostname": { "type": "boolean" },
    "set_join_password": { "type": "boolean" },
    "clear_join_password": { "type": "boolean" },
    "join_password_transport": { "const": "loopback_rcon_ephemeral" },
    "map_profile": { "type": "string", "maxLength": 48 },
    "power_support": { "type": "string", "maxLength": 48 },
    "pack_a_punch_support": { "type": "string", "maxLength": 48 },
    "event_support": { "type": "string", "maxLength": 48 },
    "boss_support": { "type": "string", "maxLength": 48 },
    "music_support": { "type": "string", "maxLength": 48 },
    "dog_round_support": { "type": "string", "maxLength": 48 },
    "active_pintemod_bosses": { "$ref": "#/$defs/nonNegativeInteger" },
    "max_pintemod_bosses": { "$ref": "#/$defs/nonNegativeInteger" }
  },
  "patternProperties": {
    "^map_[1-9][0-9]*_code$": { "type": "string", "pattern": "^zm_[a-z0-9_]+$", "maxLength": 32 },
    "^map_[1-9][0-9]*_display_name$": { "type": "string", "minLength": 1, "maxLength": 64 },
    "^map_[1-9][0-9]*_availability$": { "const": "supported" },
    "^boss_[1-9][0-9]*_alias$": { "type": "string", "pattern": "^[a-z0-9_]+$", "maxLength": 32 },
    "^power_up_[1-9][0-9]*_alias$": { "type": "string", "pattern": "^[a-z0-9_]+$", "maxLength": 32 },
    "^diagnostic_[1-9][0-9]*_alias$": { "enum": ["map_audit", "event_status", "power_ups"] }
  },
  "$defs": {
    "nonNegativeInteger": { "type": "integer", "minimum": 0, "maximum": 999999999999 }
  }
}
