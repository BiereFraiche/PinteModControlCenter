<Window x:Class="PinteMod.ControlCenter.MainWindow"
        x:Name="RootWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="{Binding WindowTitle}"
        Width="1060" Height="840"
        MinWidth="900" MinHeight="640"
        WindowStyle="None" ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        SnapsToDevicePixels="True"
        Background="{StaticResource AppBackgroundBrush}">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="34" ResizeBorderThickness="6"
                            GlassFrameThickness="0" CornerRadius="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="ServerTabRadioStyle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
            <Setter Property="Background" Value="{StaticResource SurfaceAltBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderSubtleBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="11,6" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="TabBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="{StaticResource AccentSoftBrush}" />
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource AccentBrightBrush}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="{StaticResource AppBackgroundBrush}"
            BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="{Binding ActualWidth, ElementName=RootWindow, Converter={StaticResource SidebarWidthConverter}}" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{StaticResource SidebarBrush}"
                    BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,0,1,0">
                <Grid Margin="10,22,10,16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="4,0,0,28">
                        <Border Width="44" Height="44" CornerRadius="12"
                                Background="{StaticResource AccentSoftBrush}"
                                BorderBrush="{StaticResource AccentBrush}" BorderThickness="1">
                            <TextBlock Text="PM" FontWeight="Bold" FontSize="15"
                                       Foreground="{StaticResource AccentBrightBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Margin="12,2,0,0"
                                    Visibility="{Binding ActualWidth, ElementName=RootWindow, Converter={StaticResource WidthToVisibilityConverter}, ConverterParameter=1100}">
                            <TextBlock Text="PinteMod" FontWeight="SemiBold" FontSize="16" />
                            <TextBlock Text="CONTROL CENTER" Style="{StaticResource EyebrowTextStyle}" />
                        </StackPanel>
                    </StackPanel>

                    <Border Grid.Row="1" Style="{StaticResource SimulationBadgeBorderStyle}" Margin="2,0,2,22"
                            Visibility="{Binding ActualWidth, ElementName=RootWindow, Converter={StaticResource WidthToVisibilityConverter}, ConverterParameter=1100}">
                        <StackPanel>
                            <TextBlock Text="{Binding ActiveServer.Shell.ModeLabel}" FontWeight="SemiBold" FontSize="11"
                                       Foreground="{StaticResource AccentBrightBrush}" />
                            <TextBlock Text="{Binding ActiveServer.Shell.ModeDescription}" FontSize="10"
                                       Foreground="{StaticResource TextMutedBrush}" Margin="0,3,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Row="1" Style="{StaticResource SimulationBadgeBorderStyle}" Margin="2,0,2,22"
                            ToolTip="{Binding ActiveServer.Shell.ModeDescription}"
                            Visibility="{Binding ActualWidth, ElementName=RootWindow, Converter={StaticResource WidthToVisibilityConverter}, ConverterParameter=1100:Invert}">
                        <TextBlock Text="{Binding ActiveServer.Shell.ModeShortLabel}" FontWeight="Bold" FontSize="10"
                                   Foreground="{StaticResource AccentBrightBrush}"
                                   HorizontalAlignment="Center" />
                    </Border>

                    <ItemsControl Grid.Row="2" ItemsSource="{Binding ActiveServer.Shell.NavigationItems}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <RadioButton Style="{StaticResource NavigationRadioStyle}"
                                             Content="{Binding Title}" Tag="{Binding Glyph}"
                                             ToolTip="{Binding Title}"
                                             IsChecked="{Binding IsSelected, Mode=OneWay}"
                                             Command="{Binding DataContext.ActiveServer.Shell.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                             CommandParameter="{Binding}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <StackPanel Grid.Row="3"
                                Visibility="{Binding ActualWidth, ElementName=RootWindow, Converter={StaticResource WidthToVisibilityConverter}, ConverterParameter=1100}">
                        <Border Height="1" Background="{StaticResource BorderSubtleBrush}" Margin="0,0,0,14" />
                        <TextBlock Text="PINTE MOD v2.1.1" Style="{StaticResource EyebrowTextStyle}" />
                        <TextBlock Text="Prototype v2.2 · Local uniquement" Margin="0,4,0,0"
                                   Foreground="{StaticResource TextMutedBrush}" FontSize="10" />
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="34" />
                    <RowDefinition Height="50" />
                    <RowDefinition Height="70" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="28" />
                </Grid.RowDefinitions>

                <Border x:Name="WindowDragBar" Grid.Row="0" Background="{StaticResource SidebarBrush}"
                        BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,0,0,1">
                    <Grid Margin="14,0,0,0">
                        <TextBlock Text="{Binding ActiveServer.DisplayName, StringFormat=PinteMod Control Center · {0}}"
                                   Foreground="{StaticResource TextMutedBrush}" FontSize="10"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="—" Width="42" Height="32" Padding="0" FontSize="12"
                                    Style="{StaticResource BaseButtonStyle}" BorderThickness="0" Click="MinimizeButton_Click"
                                    shell:WindowChrome.IsHitTestVisibleInChrome="True" />
                            <Button Content="□" Width="42" Height="32" Padding="0" FontSize="12"
                                    Style="{StaticResource BaseButtonStyle}" BorderThickness="0" Click="MaximizeButton_Click"
                                    shell:WindowChrome.IsHitTestVisibleInChrome="True" />
                            <Button Content="×" Width="42" Height="32" Padding="0" FontSize="14"
                                    Style="{StaticResource BaseButtonStyle}" BorderThickness="0" Click="CloseButton_Click"
                                    shell:WindowChrome.IsHitTestVisibleInChrome="True" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Row="1" Background="{StaticResource SidebarBrush}"
                        BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,0,0,1">
                    <Grid Margin="14,4,14,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                                      shell:WindowChrome.IsHitTestVisibleInChrome="True">
                            <ItemsControl ItemsSource="{Binding Servers}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <RadioButton IsChecked="{Binding IsActive, Mode=OneWay}"
                                                     Style="{StaticResource ServerTabRadioStyle}"
                                                     Command="{Binding DataContext.SelectServerCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                     CommandParameter="{Binding}"
                                                     shell:WindowChrome.IsHitTestVisibleInChrome="True">
                                            <TextBlock Text="{Binding DisplayName}" MaxWidth="150"
                                                       TextTrimming="CharacterEllipsis" />
                                        </RadioButton>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                        <Button Grid.Column="1" Content="RETIRER" Padding="9,5" Margin="8,0,0,0"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Command="{Binding RemoveServerCommand}"
                                CommandParameter="{Binding ActiveServer}"
                                ToolTip="Retirer l’onglet actif sans toucher au serveur"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True" />
                        <Button Grid.Column="2" Content="+ SERVEUR" Padding="10,5" Margin="8,0,0,0"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Command="{Binding AddServerCommand}"
                                ToolTip="Ajouter un profil serveur isolé"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True" />
                    </Grid>
                </Border>

                <Border Grid.Row="2" Background="{StaticResource AppBackgroundBrush}"
                        BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,0,0,1">
                    <Grid Margin="24,0,24,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding ActiveServer.Shell.CurrentPage.Title}" FontSize="22" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding ActiveServer.Shell.CurrentPage.Description}" Margin="0,4,0,0"
                                       Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"
                                       Visibility="{Binding ActualWidth, ElementName=RootWindow, Converter={StaticResource WidthToVisibilityConverter}, ConverterParameter=1000}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="ACTUALISER" Style="{StaticResource SecondaryButtonStyle}"
                                    Command="{Binding ActiveServer.Shell.RefreshCommand}" Margin="0,0,14,0"
                                    shell:WindowChrome.IsHitTestVisibleInChrome="True" />
                            <StackPanel HorizontalAlignment="Right"
                                        Visibility="{Binding ActualWidth, ElementName=RootWindow, Converter={StaticResource WidthToVisibilityConverter}, ConverterParameter=980}">
                                <TextBlock Text="HEURE LOCALE" Style="{StaticResource EyebrowTextStyle}" HorizontalAlignment="Right" />
                                <TextBlock Text="{Binding ActiveServer.Shell.CurrentTime}" FontSize="16" FontWeight="SemiBold"
                                           HorizontalAlignment="Right" Margin="0,3,0,0" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid Grid.Row="3">
                    <ContentControl Content="{Binding ActiveServer.Shell.CurrentPage}" />
                    <StackPanel VerticalAlignment="Top" Margin="24,10,24,0">
                        <Border Background="{StaticResource DangerSoftBrush}" BorderBrush="{StaticResource DangerBrush}"
                                BorderThickness="1" CornerRadius="5" Padding="10,7" Margin="0,0,0,6"
                                Visibility="{Binding ActiveServer.Shell.GlobalErrorMessage, Converter={StaticResource NullToVisibilityConverter}}">
                            <TextBlock Text="{Binding ActiveServer.Shell.GlobalErrorMessage}" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" />
                        </Border>
                        <Border Background="{StaticResource DangerSoftBrush}" BorderBrush="{StaticResource DangerBrush}"
                                BorderThickness="1" CornerRadius="5" Padding="10,7"
                                Visibility="{Binding ActiveServer.Shell.CurrentPage.ErrorMessage, Converter={StaticResource NullToVisibilityConverter}}">
                            <TextBlock Text="{Binding ActiveServer.Shell.CurrentPage.ErrorMessage}" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" />
                        </Border>
                        <Border Background="{StaticResource WarningSoftBrush}" BorderBrush="{StaticResource WarningBrush}"
                                BorderThickness="1" CornerRadius="5" Padding="10,7"
                                Visibility="{Binding WorkspaceNotice, Converter={StaticResource NullToVisibilityConverter}}">
                            <TextBlock Text="{Binding WorkspaceNotice}" Foreground="{StaticResource WarningBrush}" TextWrapping="Wrap" />
                        </Border>
                    </StackPanel>
                </Grid>

                <Border Grid.Row="4" Background="{StaticResource SidebarBrush}"
                        BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,1,0,0">
                    <Grid Margin="14,0">
                        <TextBlock Text="{Binding ActiveServer.Shell.ReadOnlyFooterLabel}" Style="{StaticResource EyebrowTextStyle}"
                                   VerticalAlignment="Center"
                                   Visibility="{Binding ActualWidth, ElementName=RootWindow, Converter={StaticResource WidthToVisibilityConverter}, ConverterParameter=980}" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Ellipse Width="7" Height="7" Fill="{StaticResource AccentBrush}" Margin="0,0,6,0" />
                            <TextBlock Text="Prototype actif" Foreground="{StaticResource TextSecondaryBrush}" FontSize="10" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
