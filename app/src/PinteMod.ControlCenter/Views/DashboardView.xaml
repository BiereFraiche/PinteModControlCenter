<UserControl x:Class="PinteMod.ControlCenter.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:PinteMod.ControlCenter.Controls">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="{StaticResource SurfaceAltBrush}" BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1" CornerRadius="6" Padding="10,7" Margin="0,0,0,12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{Binding ModeLabel}" Style="{StaticResource EyebrowTextStyle}"
                                   Foreground="{DynamicResource AccentBrightBrush}" VerticalAlignment="Center" />
                        <TextBlock Text=" · " Foreground="{StaticResource TextMutedBrush}" FontSize="9" Margin="6,0" />
                        <TextBlock Text="{Binding DeclaredVersionLabel}" Foreground="{StaticResource TextMutedBrush}"
                                   FontSize="9" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text=" · " Foreground="{StaticResource TextMutedBrush}" FontSize="9" Margin="6,0" />
                        <TextBlock Text="{Binding IntegrationProviderLabel}" Foreground="{DynamicResource AccentBrightBrush}"
                                   FontSize="9" FontWeight="Bold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding IntegrationProviderDetails}" />
                        <TextBlock Text=" · " Foreground="{StaticResource TextMutedBrush}" FontSize="9" Margin="6,0" />
                        <TextBlock Text="{Binding ServerRuntimeStatusLabel}" Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="9" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="DÉMARRER CE SERVEUR" Style="{StaticResource SecondaryButtonStyle}"
                                Padding="10,5" Margin="0,0,10,0" Command="{Binding StartServerCommand}"
                                IsEnabled="{Binding CanStartServer}"
                                Visibility="{Binding HasServerLaunchAction, Converter={StaticResource BooleanToVisibilityConverter}}"
                                ToolTip="Lance le profil enregistré : local via Worker v3 ou distant via l’Agent SMB pairé. Le bouton est grisé quand BOIII est déjà en ligne." />
                        <Button Content="ARRÊTER CE SERVEUR" Style="{StaticResource DangerButtonStyle}"
                                Padding="10,5" Margin="0,0,10,0" Command="{Binding StopServerCommand}"
                                IsEnabled="{Binding CanStopServer}"
                                Visibility="{Binding HasServerStopAction, Converter={StaticResource BooleanToVisibilityConverter}}"
                                ToolTip="Arrête uniquement le serveur de ce profil après confirmation. Le bouton est grisé quand BOIII est hors ligne." />
                        <Expander Header="DÉTAILS SOURCE" IsExpanded="False"
                                  Style="{StaticResource CompactDetailsExpanderStyle}" HorizontalAlignment="Right">
                            <StackPanel Width="420" Margin="10,3,0,2">
                                <TextBlock Text="{Binding ModeSummary}" Foreground="{StaticResource TextSecondaryBrush}"
                                           FontSize="9" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding InstallationSummary}"
                                           Foreground="{Binding InstallationHealth, Converter={StaticResource StatusBrushConverter}}"
                                           FontSize="9" FontWeight="SemiBold" Margin="0,4,0,0" TextWrapping="Wrap" />
                                <WrapPanel Margin="0,5,0,0">
                                    <TextBlock FontSize="9" Margin="0,0,10,3">
                                        <Run Text="Lecture : " /><Run Text="{Binding SessionReadStatus, Converter={StaticResource StatusTextConverter}, Mode=OneWay}"
                                                                       Foreground="{Binding SessionReadStatus, Converter={StaticResource StatusBrushConverter}, Mode=OneWay}" />
                                    </TextBlock>
                                    <TextBlock FontSize="9" Margin="0,0,10,3">
                                        <Run Text="Fraîcheur : " /><Run Text="{Binding SessionFreshness, Converter={StaticResource StatusTextConverter}, Mode=OneWay}"
                                                                         Foreground="{Binding SessionFreshness, Converter={StaticResource StatusBrushConverter}, Mode=OneWay}" />
                                    </TextBlock>
                                    <TextBlock Text="{Binding SessionAgeLabel}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="9" Margin="0,0,10,3" />
                                    <TextBlock Text="{Binding SessionProvenance}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="9" Margin="0,0,0,3" />
                                </WrapPanel>
                                <TextBlock Text="{Binding SessionSourceLabel}" Foreground="{DynamicResource AccentBrightBrush}"
                                           FontSize="9" FontWeight="Bold" Margin="0,2,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Margin="0,7,0,0">
                        <TextBlock Text="{Binding ServerLaunchStatus}"
                                   Foreground="{StaticResource TextSecondaryBrush}" FontSize="9"
                                   TextWrapping="Wrap" Visibility="{Binding ServerLaunchStatus, Converter={StaticResource NullToVisibilityConverter}}" />
                        <TextBlock Text="{Binding ServerControlTransportStatus}"
                                   Foreground="{StaticResource TextMutedBrush}" FontSize="9" FontWeight="SemiBold"
                                   Margin="0,3,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </Border>

            <controls:ResponsiveUniformGrid Grid.Row="1" MinItemWidth="155" MaxColumns="5" Margin="-4,-4,-4,12">
                <Border Style="{StaticResource CardStyle}" Margin="4">
                    <StackPanel>
                        <TextBlock Text="CARTE ACTUELLE" Style="{StaticResource EyebrowTextStyle}" />
                        <TextBlock Text="{Binding MapName}" Style="{StaticResource KpiValueStyle}" Margin="0,8,0,0" />
                        <TextBlock Text="{Binding MapCode}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="10" Margin="0,5,0,0" />
                        <TextBlock Text="{Binding MapSourceLabel}" Foreground="{DynamicResource AccentBrightBrush}" FontSize="9" FontWeight="Bold" Margin="0,3,0,0" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CardStyle}" Margin="4">
                    <StackPanel>
                        <TextBlock Text="MANCHE" Style="{StaticResource EyebrowTextStyle}" />
                        <TextBlock Text="{Binding RoundDisplay}" Style="{StaticResource KpiValueStyle}" Margin="0,8,0,0"
                                   Foreground="{DynamicResource AccentBrightBrush}" />
                        <TextBlock Text="{Binding RuntimeSourceLabel}" Foreground="{StaticResource TextMutedBrush}" FontSize="9" Margin="0,5,0,0" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CardStyle}" Margin="4">
                    <StackPanel>
                        <TextBlock Text="DURÉE DE SESSION" Style="{StaticResource EyebrowTextStyle}" />
                        <TextBlock Text="{Binding DurationDisplayText}"
                                   Style="{StaticResource KpiValueStyle}" Margin="0,8,0,0" />
                        <TextBlock Text="{Binding RuntimeSourceLabel}" Foreground="{StaticResource TextMutedBrush}" FontSize="9" Margin="0,5,0,0" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CardStyle}" Margin="4">
                    <StackPanel>
                        <TextBlock Text="JOUEURS CONNECTÉS" Style="{StaticResource EyebrowTextStyle}" />
                        <TextBlock Text="{Binding PlayersDisplay}" Style="{StaticResource KpiValueStyle}" Margin="0,8,0,0" />
                        <TextBlock Text="{Binding RuntimeSourceLabel}" Foreground="{StaticResource TextMutedBrush}" FontSize="9" Margin="0,5,0,0" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CardStyle}" Margin="4">
                    <StackPanel>
                        <TextBlock Text="ÉTAT DE LA PARTIE" Style="{StaticResource EyebrowTextStyle}" />
                        <TextBlock Text="{Binding RankedStatusDisplay, Converter={StaticResource StatusTextConverter}}"
                                   Style="{StaticResource KpiValueStyle}"
                                   Foreground="{Binding RankedStatusDisplay, Converter={StaticResource StatusBrushConverter}}"
                                   Margin="0,8,0,0" />
                        <TextBlock Text="{Binding RuntimeSourceLabel}" Foreground="{StaticResource TextMutedBrush}" FontSize="9" Margin="0,5,0,0" />
                    </StackPanel>
                </Border>
            </controls:ResponsiveUniformGrid>

            <Border Grid.Row="2" Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <Grid Margin="0,0,0,12">
                        <TextBlock Text="ÉTAT DES SERVICES" Style="{StaticResource SectionTitleStyle}" />
                        <TextBlock Text="{Binding ServicesSourceLabel}" Style="{StaticResource EyebrowTextStyle}" HorizontalAlignment="Right" />
                    </Grid>
                    <ItemsControl ItemsSource="{Binding Services}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <controls:ResponsiveUniformGrid MinItemWidth="210" MaxColumns="5" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource SurfaceAltBrush}" CornerRadius="6" Padding="12" Margin="4">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <Ellipse Width="9" Height="9" VerticalAlignment="Top" Margin="0,4,10,0"
                                                 Fill="{Binding Health, Converter={StaticResource StatusBrushConverter}}" />
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12" />
                                            <TextBlock Text="{Binding Description}" Foreground="{StaticResource TextSecondaryBrush}"
                                                       FontSize="10" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Health, Converter={StaticResource StatusTextConverter}}"
                                                       Foreground="{Binding Health, Converter={StaticResource StatusBrushConverter}}"
                                                       FontSize="10" FontWeight="Bold" Margin="0,5,0,0" />
                                            <Expander Header="DÉTAILS" IsExpanded="False"
                                                      Style="{StaticResource CompactDetailsExpanderStyle}"
                                                      AutomationProperties.Name="Afficher les détails de lecture du service">
                                                <StackPanel>
                                                    <Border Height="1" Background="{StaticResource BorderSubtleBrush}" Margin="0,2,0,6" />
                                                    <TextBlock FontSize="9" Margin="0,2,0,0">
                                                        <Run Text="Déclaré : " Foreground="{StaticResource TextMutedBrush}" />
                                                        <Run Text="{Binding DeclaredStateText, Mode=OneWay}"
                                                             Foreground="{Binding DeclaredState, Converter={StaticResource StatusBrushConverter}, Mode=OneWay}" />
                                                    </TextBlock>
                                                    <TextBlock FontSize="9" Margin="0,2,0,0">
                                                        <Run Text="Lecture : " Foreground="{StaticResource TextMutedBrush}" />
                                                        <Run Text="{Binding ReadStatusText, Mode=OneWay}"
                                                             Foreground="{Binding ReadStatus, Converter={StaticResource StatusBrushConverter}, Mode=OneWay}" />
                                                    </TextBlock>
                                                    <TextBlock FontSize="9" Margin="0,2,0,0">
                                                        <Run Text="Fraîcheur : " Foreground="{StaticResource TextMutedBrush}" />
                                                        <Run Text="{Binding FreshnessText, Mode=OneWay}"
                                                             Foreground="{Binding Freshness, Converter={StaticResource StatusBrushConverter}, Mode=OneWay}" />
                                                        <Run Text=" · âge " Foreground="{StaticResource TextMutedBrush}" />
                                                        <Run Text="{Binding AgeText, Mode=OneWay}" Foreground="{StaticResource TextSecondaryBrush}" />
                                                    </TextBlock>
                                                    <TextBlock FontSize="9" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"
                                                               ToolTip="{Binding SourceLabel}">
                                                        <Run Text="Provenance : " Foreground="{StaticResource TextMutedBrush}" />
                                                        <Run Text="{Binding ProvenanceText, Mode=OneWay}"
                                                             Foreground="{Binding Provenance, Converter={StaticResource StatusBrushConverter}, Mode=OneWay}" />
                                                    </TextBlock>
                                                    <TextBlock Text="{Binding CacheNotice}" Foreground="{StaticResource WarningBrush}"
                                                               FontSize="9" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,6,0,0"
                                                               Visibility="{Binding CacheNotice, Converter={StaticResource NullToVisibilityConverter}}" />
                                                </StackPanel>
                                            </Expander>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Border Grid.Row="3" Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <Grid Margin="0,0,0,12">
                        <TextBlock Text="JOUEURS" Style="{StaticResource SectionTitleStyle}" />
                        <TextBlock Text="SÉLECTION PAR XUID" Style="{StaticResource EyebrowTextStyle}" HorizontalAlignment="Right" />
                    </Grid>
                    <ListBox Grid.Row="1" ItemsSource="{Binding Players}"
                             SelectedItem="{Binding SelectedPlayer, Mode=TwoWay}"
                             ItemContainerStyle="{StaticResource PlayerListItemStyle}"
                             ItemTemplate="{StaticResource PlayerListItemTemplate}" />
                </Grid>
            </Border>

            <Border Grid.Row="4" Style="{StaticResource CardStyle}" Margin="0,0,0,16"
                    Visibility="{Binding PlayerChat, Converter={StaticResource NullToVisibilityConverter}}">
                <StackPanel>
                    <Grid Margin="0,0,0,10">
                        <TextBlock Text="DERNIERS MESSAGES JOUEURS" Style="{StaticResource SectionTitleStyle}" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Ellipse Width="7" Height="7" Fill="{DynamicResource AccentBrush}" Margin="0,0,6,0" />
                            <TextBlock Text="CHAT LOCAL · READ-ONLY" Style="{StaticResource EyebrowTextStyle}" />
                        </StackPanel>
                    </Grid>
                    <ItemsControl ItemsSource="{Binding PlayerChat.RecentMessages}"
                                  Visibility="{Binding PlayerChat.HasRecentMessages, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,0,0,1" Padding="0,7">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="70" />
                                            <ColumnDefinition Width="150" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Time}" Foreground="{StaticResource TextMutedBrush}" FontSize="9" />
                                        <TextBlock Grid.Column="1" Text="{Binding DisplayName}" FontSize="10" FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis" Margin="0,0,10,0" />
                                        <TextBlock Grid.Column="2" Text="{Binding Message}" Foreground="{StaticResource TextSecondaryBrush}"
                                                   FontSize="10" TextWrapping="Wrap" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="Aucun message joueur capturé pour ce profil."
                               Foreground="{StaticResource TextMutedBrush}" FontSize="10" HorizontalAlignment="Center" Margin="0,10,0,4"
                               Visibility="{Binding PlayerChat.HasRecentMessages, Converter={StaticResource InvertedBooleanToVisibilityConverter}}" />
                    <TextBlock Text="L’historique complet reste disponible dans l’onglet Chat joueurs."
                               Foreground="{StaticResource TextMutedBrush}" FontSize="9" Margin="0,8,0,0" HorizontalAlignment="Right" />
                </StackPanel>
            </Border>

            <controls:PlayerDetailsControl Grid.Row="5" />

            <Border Grid.Row="6" Style="{StaticResource CardStyle}" Margin="0,0,0,4">
                <Expander IsExpanded="False" AutomationProperties.Name="Afficher ou réduire les événements en direct">
                    <Expander.Header>
                        <Grid Margin="0,1,0,1">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock Text="ÉVÉNEMENTS EN DIRECT" Style="{StaticResource SectionTitleStyle}" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                                <Ellipse Width="7" Height="7" Fill="{DynamicResource AccentBrush}" Margin="0,0,6,0" />
                                <TextBlock Text="{Binding LogsSourceSummary}" Style="{StaticResource EyebrowTextStyle}" />
                            </StackPanel>
                        </Grid>
                    </Expander.Header>
                    <StackPanel Margin="0,10,0,0">
                        <ItemsControl ItemsSource="{Binding Events}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,0,0,1" Padding="0,9">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="64" /><ColumnDefinition Width="94" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Time}" Foreground="{StaticResource TextMutedBrush}" FontSize="10" />
                                            <Border Grid.Column="1" Background="{DynamicResource AccentSoftBrush}" CornerRadius="3" Padding="6,3" HorizontalAlignment="Left">
                                                <TextBlock Text="{Binding Category}" FontSize="9" FontWeight="Bold"
                                                           Foreground="{Binding Severity, Converter={StaticResource StatusBrushConverter}}" />
                                            </Border>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding Details}" Foreground="{StaticResource TextSecondaryBrush}"
                                                           FontSize="10" Margin="0,3,0,0" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Expander>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
