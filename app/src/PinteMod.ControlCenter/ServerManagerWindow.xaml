<Window x:Class="PinteMod.ControlCenter.ServerManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="Assets/PinteMod.AppIcon.png"
        Title="PinteMod Control Center · Configuration"
        Width="1080" Height="760" MinWidth="920" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded"
        Background="{StaticResource AppBackgroundBrush}">
    <Window.Resources>
        <Style x:Key="LanguageComboBoxItemStyle" TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="Background" Value="{StaticResource SurfaceAltBrush}" />
            <Setter Property="Padding" Value="8,5" />
        </Style>
        <DataTemplate x:Key="LanguageFlagTemplate">
            <Grid Width="24" Height="14">
                <Border x:Name="FrenchFlag" Visibility="Collapsed" BorderBrush="#6B7888" BorderThickness="0.5">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Background="#1E4FA3" />
                        <Border Grid.Column="1" Background="#F7F7F7" />
                        <Border Grid.Column="2" Background="#D91C2A" />
                    </Grid>
                </Border>
                <Grid x:Name="BritishFlag" Visibility="Collapsed" Background="#1E4FA3" ClipToBounds="True">
                    <Border Background="#F7F7F7" Height="6" VerticalAlignment="Center" />
                    <Border Background="#F7F7F7" Width="7" HorizontalAlignment="Center" />
                    <Border Background="#D91C2A" Height="3" VerticalAlignment="Center" />
                    <Border Background="#D91C2A" Width="3" HorizontalAlignment="Center" />
                </Grid>
            </Grid>
                <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding Code}" Value="fr-FR">
                        <Setter TargetName="FrenchFlag" Property="Visibility" Value="Visible" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Code}" Value="en-US">
                        <Setter TargetName="BritishFlag" Property="Visibility" Value="Visible" />
                    </DataTrigger>
                </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource WarningSoftBrush}" BorderBrush="{StaticResource WarningBrush}"
                BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,12"
                Visibility="{Binding UpdateAttentionVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{Binding UpdateAttentionTitle}" Foreground="{StaticResource WarningBrush}"
                               FontWeight="Bold" FontSize="13" />
                    <TextBlock Text="{Binding UpdateAttentionMessage}" Foreground="{StaticResource TextPrimaryBrush}"
                               Margin="0,5,0,0" TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                    <Button Content="METTRE À JOUR" Style="{StaticResource PrimaryButtonStyle}" Padding="10,6" Margin="0,0,7,0"
                            IsEnabled="{Binding CanInstallGitHubUpdate}" Click="InstallGitHubUpdate_Click" />
                    <Button Content="VÉRIFIER GITHUB" Style="{StaticResource SecondaryButtonStyle}" Padding="10,6" Margin="0,0,7,0"
                            Click="CheckGitHub_Click" />
                    <Button Content="SYNCHRONISER LES DEUX PC" Style="{StaticResource PrimaryButtonStyle}" Padding="10,6"
                            IsEnabled="{Binding CanSynchronizeSelectedRemote}" Click="UpdateRemoteAgent_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="16" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="PINTE MOD CONTROL CENTER" Style="{StaticResource EyebrowTextStyle}" />
                    <TextBlock Text="Configurer et gérer vos serveurs BOIII" FontSize="22" FontWeight="SemiBold" Margin="0,5,0,0" />
                    <TextBlock Text="Choisissez simplement où se trouve le serveur. Le Control Center détecte PinteMod et les scripts existants, puis n’active que les fonctions qu’il sait utiliser sans risque."
                               Foreground="{StaticResource TextSecondaryBrush}" FontSize="10" Margin="0,6,0,0" TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Border Background="{DynamicResource AccentSoftBrush}" BorderBrush="{DynamicResource AccentBrush}"
                            BorderThickness="1" CornerRadius="6" Padding="10,7" HorizontalAlignment="Right">
                        <StackPanel>
                            <TextBlock Text="INTEGRATION PREVIEW 4B1" Style="{StaticResource EyebrowTextStyle}" HorizontalAlignment="Center" />
                            <TextBlock Text="{Binding CurrentApplicationVersion}" Foreground="{DynamicResource AccentBrightBrush}" FontWeight="Bold" HorizontalAlignment="Center" FontSize="10" />
                        </StackPanel>
                    </Border>
                    <TextBlock Text="{Binding GitHubUpdateStatus}" Foreground="{StaticResource TextSecondaryBrush}"
                               FontSize="9" MaxWidth="280" TextWrapping="Wrap" TextAlignment="Right" Margin="0,7,0,0" />
                    <StackPanel Orientation="Horizontal" Margin="0,7,0,0" HorizontalAlignment="Right">
                        <ComboBox x:Name="LanguageSelector" Width="80" Height="28" Margin="0,0,6,0"
                                  Background="{StaticResource SurfaceAltBrush}" Foreground="{StaticResource TextPrimaryBrush}"
                                  BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1"
                                  ItemsSource="{Binding UiLanguages}" ItemContainerStyle="{StaticResource LanguageComboBoxItemStyle}"
                                  ItemTemplate="{StaticResource LanguageFlagTemplate}"
                                  SelectedValuePath="Code" SelectedValue="{Binding SelectedUiLanguage, Mode=OneWay}"
                                  ToolTip="Langue de l’interface" SelectionChanged="LanguageSelector_SelectionChanged">
                        </ComboBox>
                        <Button Content="VÉRIFIER GITHUB" Style="{StaticResource SecondaryButtonStyle}" Padding="9,5" Margin="0,0,6,0"
                                Click="CheckGitHub_Click" />
                        <Button Content="MODE SIMPLE" Style="{StaticResource SecondaryButtonStyle}" Padding="9,5" Margin="0,0,6,0"
                                IsEnabled="{Binding IsAdvancedMode}" Click="SimpleMode_Click" />
                        <Button Content="MODE AVANCÉ" Style="{StaticResource SecondaryButtonStyle}" Padding="9,5"
                                IsEnabled="{Binding IsSimpleMode}" Click="AdvancedMode_Click" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="290" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource CardStyle}" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="MES SERVEURS" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,10" />
                    <StackPanel Grid.Row="1" Margin="0,0,0,12">
                        <Button Content="CONFIGURER UN SERVEUR SUR CE PC" Style="{StaticResource PrimaryButtonStyle}"
                                Padding="10,8" Margin="0,0,0,7" Click="ConfigureLocal_Click" />
                        <Button Content="AJOUTER UN SERVEUR DU RÉSEAU" Style="{StaticResource SecondaryButtonStyle}"
                                Padding="10,8" Margin="0,0,0,7" Click="ConfigureNetwork_Click" />
                        <Button Content="ACTUALISER LES SERVEURS CONNUS" Style="{StaticResource SecondaryButtonStyle}"
                                Padding="10,8" Click="RefreshKnownServers_Click"
                                ToolTip="Relit les dossiers locaux et réseau enregistrés, sans appairage ni commande distante." />
                    </StackPanel>
                    <ListBox Grid.Row="2" ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile, Mode=TwoWay}"
                             SelectionChanged="Profiles_SelectionChanged" Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource SurfaceAltBrush}" BorderBrush="{StaticResource BorderSubtleBrush}"
                                        BorderThickness="1" CornerRadius="5" Padding="10" Margin="0,0,0,7" MinWidth="235">
                                    <StackPanel>
                                        <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                            <TextBlock Text="{Binding IntegrationLabel}" Foreground="{DynamicResource AccentBrightBrush}" FontSize="9" FontWeight="Bold" />
                                            <TextBlock Text=" · " Foreground="{StaticResource TextMutedBrush}"
                                                       Visibility="{Binding DataContext.IsAdvancedMode, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                            <TextBlock Text="{Binding ProfileId}" Foreground="{StaticResource TextMutedBrush}" FontSize="9"
                                                       Visibility="{Binding DataContext.IsAdvancedMode, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <StackPanel Grid.Row="3" Margin="0,10,0,0">
                        <Button Content="+ AJOUTER UN PROFIL" Style="{StaticResource SecondaryButtonStyle}" Padding="10,6" Margin="0,0,0,7"
                                Visibility="{Binding IsAdvancedMode, Converter={StaticResource BooleanToVisibilityConverter}}" Click="AddProfile_Click" />
                        <Button Content="RETIRER CE SERVEUR" Style="{StaticResource DangerButtonStyle}"
                                Padding="10,6" Click="RemoveProfile_Click" />
                    </StackPanel>
                </Grid>
            </Border>

            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Border Style="{StaticResource CardStyle}" Padding="16" Margin="0,0,0,10">
                        <StackPanel>
                            <Grid>
                                <StackPanel>
                                    <TextBlock Text="CONFIGURATION GUIDÉE" Style="{StaticResource SectionTitleStyle}" />
                                    <TextBlock Text="Choisissez le dossier, puis le bouton principal prépare et démarre le serveur."
                                               Foreground="{StaticResource TextSecondaryBrush}" FontSize="10" Margin="0,4,0,0" />
                                </StackPanel>
                                <TextBlock Text="{Binding SelectedProfile.IntegrationLabel}" HorizontalAlignment="Right" VerticalAlignment="Top"
                                           Foreground="{DynamicResource AccentBrightBrush}" FontWeight="Bold" FontSize="10" />
                            </Grid>

                            <Grid Margin="0,14,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="NOM DU SERVEUR" Style="{StaticResource EyebrowTextStyle}" />
                                    <TextBox Text="{Binding SelectedProfile.DisplayName, UpdateSourceTrigger=PropertyChanged}" Margin="0,5,0,0"
                                             ToolTip="Nom affiché uniquement dans le Control Center." />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="DOSSIER DU SERVEUR" Style="{StaticResource EyebrowTextStyle}" />
                                    <Grid Margin="0,5,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox Text="{Binding SelectedProfile.ServerRoot, UpdateSourceTrigger=PropertyChanged}" />
                                        <Button Grid.Column="1" Content="CHOISIR" Style="{StaticResource SecondaryButtonStyle}"
                                                Padding="10,6" Margin="8,0,0,0" Click="BrowseRoot_Click" />
                                    </Grid>
                                </StackPanel>
                            </Grid>

                            <StackPanel Margin="0,12,0,0"
                                        Visibility="{Binding SelectedProfile.IsUncProfile, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock Text="ADRESSE LOCALE DU PC SERVEUR" Style="{StaticResource EyebrowTextStyle}" />
                                <TextBox Text="{Binding SelectedProfile.RconAddress, UpdateSourceTrigger=PropertyChanged}" Margin="0,5,0,0"
                                         ToolTip="Exemple : 192.168.x.x. Utilisée uniquement pour les commandes de contrôle sur votre réseau local." />
                                <TextBlock Text="Si votre dossier réseau commence déjà par une adresse IP, ce champ est rempli automatiquement. Sinon indiquez l’IP locale du PC qui héberge BOIII."
                                           Foreground="{StaticResource TextMutedBrush}" FontSize="9" Margin="0,4,0,0" TextWrapping="Wrap" />
                            </StackPanel>

                            <TextBlock Text="{Binding SelectedProfile.ServerPortSummary}" Foreground="{StaticResource TextSecondaryBrush}"
                                       FontSize="10" Margin="0,8,0,0" TextWrapping="Wrap" />

                            <Border Background="{StaticResource SurfaceAltBrush}" BorderBrush="{StaticResource BorderSubtleBrush}"
                                    BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,14,0,0">
                                <StackPanel>
                                    <TextBlock Text="{Binding SelectedProfile.SimpleStateTitle}" FontSize="15" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding SelectedProfile.SimpleStateMessage}" Foreground="{StaticResource TextSecondaryBrush}"
                                               Margin="0,5,0,0" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding SelectedProfile.ThirdPartySummary}" Foreground="{StaticResource TextMutedBrush}"
                                               FontSize="9" Margin="0,6,0,0" TextWrapping="Wrap"
                                               Visibility="{Binding SelectedProfile.HasThirdPartyScripts, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                </StackPanel>
                            </Border>

                            <WrapPanel Margin="0,14,0,0">
                                <Button Content="{Binding SelectedProfile.RecommendedActionLabel}" Style="{StaticResource PrimaryButtonStyle}"
                                        Padding="13,8" Margin="0,0,8,8" Click="RecommendedAction_Click" />
                                <Button Content="ANALYSER À NOUVEAU" Style="{StaticResource SecondaryButtonStyle}"
                                        Padding="11,8" Margin="0,0,8,8" Click="Analyze_Click" />
                                <Button Content="ENREGISTRER" Style="{StaticResource SecondaryButtonStyle}"
                                        Padding="11,8" Margin="0,0,8,8" Click="Save_Click" />
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardStyle}" Padding="16" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="FONCTIONS DISPONIBLES" Style="{StaticResource SectionTitleStyle}" />
                            <TextBlock Text="Le Control Center active uniquement ce que le serveur peut prouver. Une fonction inconnue reste désactivée au lieu d’envoyer une commande au hasard."
                                       Foreground="{StaticResource TextSecondaryBrush}" FontSize="10" Margin="0,5,0,10" TextWrapping="Wrap" />
                            <ItemsControl ItemsSource="{Binding SelectedProfile.Capabilities}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource SurfaceAltBrush}" BorderBrush="{StaticResource BorderSubtleBrush}"
                                                BorderThickness="1" CornerRadius="5" Padding="10" Margin="0,0,0,6">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="180" />
                                                    <ColumnDefinition Width="100" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                                <TextBlock Grid.Column="1" Text="{Binding StatusLabel}" Foreground="{DynamicResource AccentBrightBrush}"
                                                           FontSize="9" FontWeight="Bold" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="2" Text="{Binding Details}" Foreground="{StaticResource TextSecondaryBrush}"
                                                           FontSize="9" TextWrapping="Wrap" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardStyle}" Padding="16" Margin="0,0,0,10"
                            Visibility="{Binding IsSimpleMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel>
                            <TextBlock Text="LIAISON AVEC LE PC SERVEUR" Style="{StaticResource SectionTitleStyle}" />
                            <TextBlock Text="Le Control Center vérifie automatiquement si cette machine et le PC serveur sont bien appairés. Vous n’avez à connecter un serveur réseau qu’une seule fois."
                                       Foreground="{StaticResource TextSecondaryBrush}" FontSize="10" Margin="0,6,0,0" TextWrapping="Wrap" />

                            <Border BorderThickness="1" CornerRadius="7" Padding="12" Margin="0,12,0,0">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="BorderBrush" Value="{StaticResource TextMutedBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedProfile.RemoteConnectionLinked}" Value="True">
                                                <Setter Property="BorderBrush" Value="{StaticResource SuccessBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding SelectedProfile.RemoteConnectionPairedOffline}" Value="True">
                                                <Setter Property="BorderBrush" Value="{StaticResource WarningBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding SelectedProfile.RemoteConnectionNeedsPairing}" Value="True">
                                                <Setter Property="BorderBrush" Value="{DynamicResource AccentBrightBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="●" Margin="0,0,8,0" VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding SelectedProfile.RemoteConnectionLinked}" Value="True">
                                                            <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding SelectedProfile.RemoteConnectionPairedOffline}" Value="True">
                                                            <Setter Property="Foreground" Value="{StaticResource WarningBrush}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding SelectedProfile.RemoteConnectionNeedsPairing}" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource AccentBrightBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Text="{Binding SelectedProfile.RemoteConnectionTitle}" FontWeight="Bold" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding SelectedProfile.RemoteConnectionSummary}"
                                               Foreground="{StaticResource TextSecondaryBrush}" FontSize="10" Margin="20,5,0,0" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <WrapPanel Margin="0,12,0,0">
                                <Button Content="AUTORISER CE PC COMME SERVEUR" Style="{StaticResource SecondaryButtonStyle}"
                                        IsEnabled="{Binding SelectedProfile.CanEnableRemoteAgentLocal}" Padding="11,7" Margin="0,0,8,8" Click="EnableRemoteAgent_Click" />
                                <Button Content="CONNECTER CE SERVEUR RÉSEAU" Style="{StaticResource SecondaryButtonStyle}"
                                        IsEnabled="{Binding SelectedProfile.CanPairRemoteAgent}"
                                        Visibility="{Binding SelectedProfile.CanPairRemoteAgent, Converter={StaticResource BooleanToVisibilityConverter}}"
                                        Padding="11,7" Margin="0,0,8,8" Click="PairRemoteAgent_Click" />
                                <Button Content="TESTER LA LIAISON" Style="{StaticResource SecondaryButtonStyle}"
                                        Visibility="{Binding SelectedProfile.IsUncProfile, Converter={StaticResource BooleanToVisibilityConverter}}"
                                        Padding="11,7" Margin="0,0,8,8" Click="RefreshRemoteAgent_Click" />
                                <Button Content="SYNCHRONISER LES DEUX PC" Style="{StaticResource SecondaryButtonStyle}"
                                        IsEnabled="{Binding SelectedProfile.CanUpdateRemoteAgent}" Padding="11,7" Margin="0,0,8,8" Click="UpdateRemoteAgent_Click" />
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <StackPanel Visibility="{Binding IsAdvancedMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Expander Header="▸ Détails techniques du profil" IsExpanded="False" Margin="0,0,0,10">
                            <Border Style="{StaticResource CardStyle}" Padding="16" Margin="0,6,0,0">
                                <StackPanel>
                                    <TextBlock Text="PROFIL TECHNIQUE" Style="{StaticResource SectionTitleStyle}" />
                                    <Grid Margin="0,12,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="12" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="ADRESSE DE CONTRÔLE (RCON)" Style="{StaticResource EyebrowTextStyle}" />
                                            <TextBox Text="{Binding SelectedProfile.RconAddress, UpdateSourceTrigger=PropertyChanged}" Margin="0,5,0,0" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="PORT" Style="{StaticResource EyebrowTextStyle}" />
                                            <TextBox Text="{Binding SelectedProfile.RconPortText, UpdateSourceTrigger=PropertyChanged}" Margin="0,5,0,0" />
                                        </StackPanel>
                                    </Grid>
                                    <TextBlock Text="LANCEUR LOCAL" Style="{StaticResource EyebrowTextStyle}" Margin="0,12,0,0" />
                                    <ComboBox ItemsSource="{Binding SelectedProfile.LauncherCandidates}"
                                              Text="{Binding SelectedProfile.LauncherRelativePath, UpdateSourceTrigger=PropertyChanged}"
                                              IsEditable="True" IsTextSearchEnabled="True" Margin="0,5,0,0" />
                                </StackPanel>
                            </Border>
                        </Expander>

                        <Expander Header="▸ Installation, Bridge et diagnostic" IsExpanded="False" Margin="0,0,0,10">
                            <Border Style="{StaticResource CardStyle}" Padding="16" Margin="0,6,0,0">
                                <StackPanel>
                                    <TextBlock Text="INTÉGRATION" Style="{StaticResource SectionTitleStyle}" />
                                    <Border Background="{StaticResource SurfaceAltBrush}" BorderBrush="{StaticResource BorderSubtleBrush}"
                                            BorderThickness="1" CornerRadius="5" Padding="10" Margin="0,10,0,0">
                                        <StackPanel>
                                            <TextBlock Text="{Binding SelectedProfile.AnalysisSummary}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding SelectedProfile.AnalysisDetails}" Foreground="{StaticResource TextSecondaryBrush}"
                                                       FontSize="9" Margin="0,5,0,0" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>
                                    <WrapPanel Margin="0,12,0,0">
                                        <Button Content="{Binding SelectedProfile.PinteModInstallActionLabel}" Style="{StaticResource SecondaryButtonStyle}"
                                                IsEnabled="{Binding SelectedProfile.CanInstallPinteMod}" Padding="11,7" Margin="0,0,8,8" Click="InstallPinteMod_Click" />
                                        <Button Content="INSTALLER / METTRE À JOUR LE MODULE DE COMPATIBILITÉ" Style="{StaticResource SecondaryButtonStyle}"
                                                IsEnabled="{Binding SelectedProfile.CanInstallBridge}" Padding="11,7" Margin="0,0,8,8" Click="InstallBridge_Click" />
                                    </WrapPanel>
                                    <TextBlock Text="Aucun script tiers n’est modifié automatiquement. Une collision avec un fichier inconnu bloque l’installation."
                                               Foreground="{StaticResource WarningBrush}" FontSize="9" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </Expander>

                        <Expander Header="▸ Agent distant / réseau" IsExpanded="False" Margin="0,0,0,10">
                            <Border Style="{StaticResource CardStyle}" Padding="16" Margin="0,6,0,0">
                                <StackPanel>
                                    <TextBlock Text="AGENT DISTANT" Style="{StaticResource SectionTitleStyle}" />
                                    <TextBlock Text="{Binding SelectedProfile.RemoteAgentStatus}" FontWeight="SemiBold" Margin="0,10,0,0" TextWrapping="Wrap" />
                                    <WrapPanel Margin="0,12,0,0">
                                        <Button Content="ACTIVER / MAJ AGENT SUR CE PC" Style="{StaticResource SecondaryButtonStyle}"
                                                IsEnabled="{Binding SelectedProfile.CanEnableRemoteAgentLocal}" Padding="11,7" Margin="0,0,8,8" Click="EnableRemoteAgent_Click" />
                                        <Button Content="DÉSACTIVER L’AGENT SUR CE PC" Style="{StaticResource DangerButtonStyle}"
                                                Padding="11,7" Margin="0,0,8,8" Click="DisableRemoteAgent_Click" />
                                        <Button Content="PAIRER CE PROFIL DISTANT" Style="{StaticResource SecondaryButtonStyle}"
                                                IsEnabled="{Binding SelectedProfile.CanPairRemoteAgent}" Padding="11,7" Margin="0,0,8,8" Click="PairRemoteAgent_Click" />
                                        <Button Content="SYNCHRONISER LES DEUX PC" Style="{StaticResource SecondaryButtonStyle}"
                                                IsEnabled="{Binding SelectedProfile.CanUpdateRemoteAgent}" Padding="11,7" Margin="0,0,8,8" Click="UpdateRemoteAgent_Click" />
                                        <Button Content="ACTUALISER" Style="{StaticResource SecondaryButtonStyle}"
                                                Padding="11,7" Margin="0,0,8,8" Click="RefreshRemoteAgent_Click" />
                                    </WrapPanel>
                                    <TextBlock Text="Transport SMB signé HMAC, clé locale DPAPI, aucun nouveau port entrant, aucune commande ou chemin libre accepté."
                                               Foreground="{StaticResource TextMutedBrush}" FontSize="9" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </Expander>

                        <Expander Header="▸ Stockage et maintenance" IsExpanded="False" Margin="0,0,0,10">
                            <Border Style="{StaticResource CardStyle}" Padding="16" Margin="0,6,0,0">
                                <StackPanel>
                                    <TextBlock Text="STOCKAGE &amp; MAINTENANCE" Style="{StaticResource SectionTitleStyle}" />
                                    <TextBlock Text="{Binding SelectedProfile.StorageSummary}" Margin="0,10,0,0"
                                               Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" />
                                    <WrapPanel Margin="0,12,0,0">
                                        <Button Content="ANALYSER LE STOCKAGE" Style="{StaticResource SecondaryButtonStyle}"
                                                Padding="11,7" Margin="0,0,8,8" Click="AnalyzeStorage_Click" />
                                        <Button Content="RÉPARER LES STATS GEOIP" Style="{StaticResource DangerButtonStyle}"
                                                Padding="11,7" Margin="0,0,8,8"
                                                IsEnabled="{Binding SelectedProfile.GeoIpMaintenanceRecommended}"
                                                Click="RepairGeoIp_Click" />
                                    </WrapPanel>
                                    <TextBlock Text="Les opérations de maintenance ne touchent jamais aux ranks, records, langues, bans, profils joueurs ou secrets RCON."
                                               Foreground="{StaticResource TextMutedBrush}" FontSize="9" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </Expander>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <Border Grid.Row="3" Style="{StaticResource CardStyle}" Padding="12" Margin="0,12,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource TextSecondaryBrush}"
                               TextWrapping="Wrap" />
                    <CheckBox x:Name="KeepManagerOpenCheck"
                              Content="Garder cette fenêtre ouverte après l’ouverture du Control Center"
                              IsChecked="{Binding KeepManagerOpenAfterControlCenter, Mode=OneWay}"
                              Foreground="{StaticResource TextSecondaryBrush}" FontSize="10" Margin="0,7,0,0"
                              Click="KeepManagerOpen_Click" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="QUITTER" Style="{StaticResource SecondaryButtonStyle}" Padding="12,7" Margin="0,0,8,0" Click="Cancel_Click" />
                    <Button Content="LANCER TOUS" Style="{StaticResource SecondaryButtonStyle}" Padding="12,7" Margin="0,0,8,0"
                            Click="LaunchAll_Click" />
                    <Button Content="DÉMARRER" Style="{StaticResource SecondaryButtonStyle}" Padding="12,7" Margin="0,0,8,0"
                            IsEnabled="{Binding SelectedProfile.CanLaunchSelected}" Click="LaunchSelected_Click" />
                    <Button Content="ARRÊTER" Style="{StaticResource DangerButtonStyle}" Padding="12,7" Margin="0,0,8,0"
                            IsEnabled="{Binding SelectedProfile.CanStopSelected}" Click="StopSelected_Click" />
                    <Button Content="OUVRIR CONTROL CENTER" Style="{StaticResource PrimaryButtonStyle}" Padding="14,7" Click="OpenControlCenter_Click" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
