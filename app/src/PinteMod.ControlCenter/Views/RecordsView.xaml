<UserControl x:Class="PinteMod.ControlCenter.Views.RecordsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:PinteMod.ControlCenter.Controls">
    <UserControl.Resources>
        <Style x:Key="FastRecordComboBoxItemStyle" TargetType="{x:Type ComboBoxItem}">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ComboBoxItem}">
                        <Border x:Name="ItemBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5"
                                Margin="2,1"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource AccentBrightBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource SurfaceHoverBrush}" />
                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{DynamicResource AccentBrightBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ItemBorder" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FastRecordComboBoxStyle" TargetType="{x:Type ComboBox}">
            <Setter Property="Background" Value="{StaticResource SurfaceAltBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="11,7" />
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="IsTextSearchEnabled" Value="False" />
            <Setter Property="MaxDropDownHeight" Value="280" />
            <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
            <Setter Property="ScrollViewer.IsDeferredScrollingEnabled" Value="True" />
            <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
            <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource FastRecordComboBoxItemStyle}" />
            <Setter Property="ItemsPanel">
                <Setter.Value>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel />
                    </ItemsPanelTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ComboBox}">
                        <Grid>
                            <Border x:Name="ComboBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="6">
                                <Grid>
                                    <ContentPresenter Margin="11,0,38,0"
                                                      VerticalAlignment="Center"
                                                      HorizontalAlignment="Left"
                                                      Content="{TemplateBinding SelectionBoxItem}"
                                                      ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                      ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                                      TextElement.Foreground="{TemplateBinding Foreground}" />
                                    <Border HorizontalAlignment="Right" Width="34" Background="Transparent">
                                        <Path x:Name="Arrow"
                                              Data="M 0 0 L 4 4 L 8 0"
                                              Stroke="{DynamicResource AccentBrightBrush}"
                                              StrokeThickness="1.6"
                                              StrokeStartLineCap="Round"
                                              StrokeEndLineCap="Round"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                                    </Border>
                                </Grid>
                            </Border>
                            <ToggleButton Focusable="False"
                                          Background="Transparent"
                                          BorderThickness="0"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="{x:Type ToggleButton}">
                                        <Border Background="Transparent" />
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <Popup x:Name="PART_Popup"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   Placement="Bottom"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Fade">
                                <Border Background="{StaticResource SurfaceAltBrush}"
                                        BorderBrush="{DynamicResource AccentBrush}"
                                        BorderThickness="1"
                                        CornerRadius="7"
                                        Padding="4"
                                        Margin="0,3,0,0"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                                    <ScrollViewer MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                                  CanContentScroll="True"
                                                  VerticalScrollBarVisibility="Auto"
                                                  HorizontalScrollBarVisibility="Disabled">
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ComboBorder" Property="Background" Value="{StaticResource SurfaceHoverBrush}" />
                                <Setter TargetName="ComboBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsDropDownOpen" Value="True">
                                <Setter TargetName="ComboBorder" Property="Background" Value="{StaticResource SurfaceHoverBrush}" />
                                <Setter TargetName="ComboBorder" Property="BorderBrush" Value="{DynamicResource AccentBrightBrush}" />
                                <Setter TargetName="ComboBorder" Property="BorderThickness" Value="1.5" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="ComboBorder" Property="BorderBrush" Value="{DynamicResource AccentBrightBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ComboBorder" Property="Opacity" Value="0.4" />
                                <Setter TargetName="Arrow" Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="VirtualRecordItemStyle" TargetType="{x:Type ListBoxItem}">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ListBoxItem}">
                        <ContentPresenter HorizontalAlignment="Stretch" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <controls:ResponsiveUniformGrid Grid.Row="0" MinItemWidth="180" MaxColumns="4" Margin="-4,-4,-4,12">
                <Border Style="{StaticResource CardStyle}" Margin="4">
                    <StackPanel><TextBlock Text="PROFILS RANKS" Style="{StaticResource EyebrowTextStyle}" /><TextBlock Text="{Binding RankProfileCount}" Style="{StaticResource KpiValueStyle}" Margin="0,8,0,0" /><TextBlock Text="PROFILS DU SNAPSHOT" Foreground="{StaticResource TextSecondaryBrush}" FontSize="10" Margin="0,5,0,0" /></StackPanel>
                </Border>
                <Border Style="{StaticResource CardStyle}" Margin="4">
                    <StackPanel><TextBlock Text="RECORDS DE MANCHES" Style="{StaticResource EyebrowTextStyle}" /><TextBlock Text="{Binding StandardRecordCount}" Style="{StaticResource KpiValueStyle}" Margin="0,8,0,0" /><TextBlock Text="TOP 5 · CATÉGORIES 1–4P" Foreground="{StaticResource TextSecondaryBrush}" FontSize="10" Margin="0,5,0,0" /></StackPanel>
                </Border>
                <Border Style="{StaticResource CardStyle}" Margin="4">
                    <StackPanel><TextBlock Text="EASTER EGG RECORDS" Style="{StaticResource EyebrowTextStyle}" /><TextBlock Text="{Binding EasterEggRecordCount}" Style="{StaticResource KpiValueStyle}" Foreground="{StaticResource PurpleBrush}" Margin="0,8,0,0" /><TextBlock Text="{Binding EasterEggKpiCaption}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="10" Margin="0,5,0,0" /></StackPanel>
                </Border>
                <Border Style="{StaticResource CardStyle}" Margin="4">
                    <StackPanel><TextBlock Text="ÉTAT DE LA SESSION" Style="{StaticResource EyebrowTextStyle}" /><TextBlock Text="{Binding RankedStatus, Converter={StaticResource StatusTextConverter}}" Style="{StaticResource KpiValueStyle}" Foreground="{Binding RankedStatus, Converter={StaticResource StatusBrushConverter}}" Margin="0,8,0,0" /><TextBlock Text="{Binding RankedStatusCaption}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="10" Margin="0,5,0,0" /></StackPanel>
                </Border>
            </controls:ResponsiveUniformGrid>

            <Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="0,0,0,12" Padding="10,8">
                <Expander IsExpanded="False" Style="{StaticResource CompactDetailsExpanderStyle}">
                    <Expander.Header>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="SOURCE DES DONNÉES" Style="{StaticResource EyebrowTextStyle}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="{Binding SectionDescription}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="9"
                                       Margin="12,0,12,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="2" Text="{Binding DataBadge}" Foreground="{DynamicResource AccentBrightBrush}" FontSize="9" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </Grid>
                    </Expander.Header>
                    <Grid Margin="14,8,0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,16,0">
                            <TextBlock Text="PROFILS" Style="{StaticResource EyebrowTextStyle}" />
                            <TextBlock Text="{Binding RankSourceSummary}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="9" Margin="0,3,0,0" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding RankSourceLabel}" Foreground="{DynamicResource AccentBrightBrush}" FontSize="9" Margin="0,2,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="0,0,16,0">
                            <TextBlock Text="MANCHES" Style="{StaticResource EyebrowTextStyle}" />
                            <TextBlock Text="{Binding RoundRecordSourceSummary}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="9" Margin="0,3,0,0" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding RoundRecordSourceLabel}" Foreground="{DynamicResource AccentBrightBrush}" FontSize="9" Margin="0,2,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="EASTER EGG" Style="{StaticResource EyebrowTextStyle}" />
                            <TextBlock Text="{Binding EasterEggRecordSourceSummary}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="9" Margin="0,3,0,0" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding EasterEggRecordSourceLabel}" Foreground="{DynamicResource AccentBrightBrush}" FontSize="9" Margin="0,2,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                </Expander>
            </Border>

            <Border Grid.Row="3" Style="{StaticResource CardStyle}" Margin="0,16,0,0">
                <StackPanel>
                    <Grid Margin="0,0,0,12">
                        <TextBlock Text="PROFILS RANKS" Style="{StaticResource SectionTitleStyle}" />
                        <TextBlock Text="{Binding RankFilesSummary}" HorizontalAlignment="Right" Foreground="{StaticResource TextSecondaryBrush}" FontSize="10" />
                    </Grid>
                    <ScrollViewer MaxHeight="360" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                  Visibility="{Binding HasRankProfiles, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <ItemsControl ItemsSource="{Binding RankProfiles}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><controls:ResponsiveUniformGrid MinItemWidth="205" MaxColumns="4" /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource SurfaceAltBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="4">
                                        <StackPanel>
                                            <TextBlock Text="{Binding DisplayName}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            <Expander Header="IDENTIFIANT" IsExpanded="False" Margin="0,1,0,5"
                                                      Style="{StaticResource CompactDetailsExpanderStyle}"
                                                      AutomationProperties.Name="Afficher l’identifiant abrégé du profil">
                                                <TextBlock Text="{Binding ShortXuid}" Foreground="{DynamicResource AccentBrightBrush}"
                                                           FontSize="10" Margin="14,0,0,5" />
                                            </Expander>
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                                                <StackPanel><TextBlock Text="SESSIONS" Style="{StaticResource EyebrowTextStyle}" /><TextBlock Text="{Binding Sessions}" Margin="0,4,0,0" /></StackPanel>
                                                <StackPanel Grid.Column="1"><TextBlock Text="MEILLEURE" Style="{StaticResource EyebrowTextStyle}" /><TextBlock Text="{Binding BestOverallRound}" Margin="0,4,0,0" Foreground="{DynamicResource AccentBrightBrush}" /></StackPanel>
                                                <StackPanel Grid.Column="2"><TextBlock Text="TEMPS" Style="{StaticResource EyebrowTextStyle}" /><TextBlock Text="{Binding TotalPlayTime}" Margin="0,4,0,0" /></StackPanel>
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <TextBlock Text="{Binding RankEmptyMessage}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" TextWrapping="Wrap" HorizontalAlignment="Center" Margin="0,24"
                               Visibility="{Binding HasRankProfiles, Converter={StaticResource InvertedBooleanToVisibilityConverter}}" />
                </StackPanel>
            </Border>

            <StackPanel Grid.Row="2">
                <Grid Margin="0,0,0,10">
                    <TextBlock Text="RECORDS" Style="{StaticResource SectionTitleStyle}" />
                    <StackPanel HorizontalAlignment="Right">
                        <TextBlock Text="{Binding RecordFilesSummary}" HorizontalAlignment="Right" Foreground="{StaticResource TextSecondaryBrush}" FontSize="10" />
                        <TextBlock Text="{Binding EasterEggFilesSummary}" HorizontalAlignment="Right" Foreground="{StaticResource TextSecondaryBrush}" FontSize="10" Margin="0,3,0,0" />
                    </StackPanel>
                </Grid>

                <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12" Padding="14">
                    <StackPanel>
                        <Grid Margin="0,0,0,10">
                            <TextBlock Text="FILTRES &amp; TRI" Style="{StaticResource SectionTitleStyle}" />
                            <TextBlock Text="{Binding FilterSummary}" HorizontalAlignment="Right"
                                       Foreground="{DynamicResource AccentBrightBrush}" FontSize="10" FontWeight="SemiBold" />
                        </Grid>
                        <WrapPanel>
                            <StackPanel Margin="0,0,12,8">
                                <TextBlock Text="TYPE" Style="{StaticResource EyebrowTextStyle}" Margin="0,0,0,4" />
                                <ComboBox Width="180" Style="{StaticResource FastRecordComboBoxStyle}" ItemsSource="{Binding RecordTypeOptions}" DisplayMemberPath="Label" SelectedValuePath="Key"
                                          SelectedValue="{Binding SelectedRecordTypeKey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,12,8">
                                <TextBlock Text="CARTE" Style="{StaticResource EyebrowTextStyle}" Margin="0,0,0,4" />
                                <ComboBox Width="210" Style="{StaticResource FastRecordComboBoxStyle}" ItemsSource="{Binding RecordMapOptions}" DisplayMemberPath="Label" SelectedValuePath="Key"
                                          SelectedValue="{Binding SelectedRecordMapKey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,12,8">
                                <TextBlock Text="NOMBRE DE JOUEURS" Style="{StaticResource EyebrowTextStyle}" Margin="0,0,0,4" />
                                <ComboBox Width="160" Style="{StaticResource FastRecordComboBoxStyle}" ItemsSource="{Binding RecordPlayerCountOptions}" DisplayMemberPath="Label" SelectedValuePath="Key"
                                          SelectedValue="{Binding SelectedRecordPlayerCountKey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,12,8">
                                <TextBlock Text="JOUEUR / DÉTENTEUR" Style="{StaticResource EyebrowTextStyle}" Margin="0,0,0,4" />
                                <ComboBox Width="190" Style="{StaticResource FastRecordComboBoxStyle}" ItemsSource="{Binding RecordHolderOptions}" DisplayMemberPath="Label" SelectedValuePath="Key"
                                          SelectedValue="{Binding SelectedRecordHolderKey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,12,8">
                                <TextBlock Text="TRIER PAR" Style="{StaticResource EyebrowTextStyle}" Margin="0,0,0,4" />
                                <ComboBox Width="190" Style="{StaticResource FastRecordComboBoxStyle}" ItemsSource="{Binding RecordSortOptions}" DisplayMemberPath="Label" SelectedValuePath="Key"
                                          SelectedValue="{Binding SelectedRecordSortKey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,0,8">
                                <TextBlock Text="AFFICHAGE" Style="{StaticResource EyebrowTextStyle}" Margin="0,0,0,4" />
                                <ComboBox Width="150" Style="{StaticResource FastRecordComboBoxStyle}" ItemsSource="{Binding RecordPageSizeOptions}" DisplayMemberPath="Label" SelectedValuePath="Key"
                                          SelectedValue="{Binding SelectedRecordPageSizeKey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          ToolTip="50 par défaut pour garder l’onglet fluide. Les filtres et tris utilisent toujours tous les records." />
                            </StackPanel>
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <ListBox ItemsSource="{Binding Records}" MaxHeight="620" Background="Transparent" BorderThickness="0" Padding="0"
                         ItemContainerStyle="{StaticResource VirtualRecordItemStyle}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto"
                         ScrollViewer.CanContentScroll="True" ScrollViewer.IsDeferredScrollingEnabled="True"
                         VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                         Visibility="{Binding HasRecords, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,10">
                                <controls:ResponsiveUniformGrid MinItemWidth="130" MaxColumns="6">
                                    <StackPanel Margin="0,0,12,8"><TextBlock Text="{Binding MapName}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" /><TextBlock Text="{Binding MapCode}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="10" Margin="0,4,0,0" /></StackPanel>
                                    <StackPanel Margin="0,0,12,8"><TextBlock Text="CLASSEMENT" Style="{StaticResource EyebrowTextStyle}" /><TextBlock Text="{Binding Position}" Margin="0,5,0,0" FontSize="11" Foreground="{DynamicResource AccentBrightBrush}" /></StackPanel>
                                    <StackPanel Margin="0,0,12,8"><TextBlock Text="CATÉGORIE" Style="{StaticResource EyebrowTextStyle}" /><TextBlock Text="{Binding Category}" Margin="0,5,0,0" FontSize="11" TextWrapping="Wrap" /></StackPanel>
                                    <StackPanel Margin="0,0,12,8"><TextBlock Text="RÉSULTAT" Style="{StaticResource EyebrowTextStyle}" /><TextBlock Text="{Binding Result}" Margin="0,5,0,0" FontSize="11" Foreground="{DynamicResource AccentBrightBrush}" TextWrapping="Wrap" /></StackPanel>
                                    <StackPanel Margin="0,0,12,8"><TextBlock Text="DÉTENTEUR" Style="{StaticResource EyebrowTextStyle}" /><TextBlock Text="{Binding Holder}" Margin="0,5,0,0" FontSize="11" TextWrapping="Wrap" /><TextBlock Text="{Binding HolderXuids}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="9" Margin="0,3,0,0" TextWrapping="Wrap" /></StackPanel>
                                    <StackPanel Margin="0,0,0,8"><Border Background="{DynamicResource AccentSoftBrush}" CornerRadius="5" Padding="12,8"><TextBlock Text="{Binding Duration}" Foreground="{DynamicResource AccentBrightBrush}" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center" /></Border><TextBlock Text="{Binding Provenance}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="9" HorizontalAlignment="Center" Margin="0,4,0,0" /></StackPanel>
                                </controls:ResponsiveUniformGrid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <Border Style="{StaticResource CardStyle}" MinHeight="150" Visibility="{Binding HasRecords, Converter={StaticResource InvertedBooleanToVisibilityConverter}}">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="AUCUN RECORD" Style="{StaticResource EyebrowTextStyle}" HorizontalAlignment="Center" />
                        <TextBlock Text="{Binding RecordsEmptyMessage}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,7,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
