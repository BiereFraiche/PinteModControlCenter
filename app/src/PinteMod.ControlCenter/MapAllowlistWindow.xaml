<Window x:Class="PinteMod.ControlCenter.MapAllowlistWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cartes autorisées · Change Map"
        Width="620" Height="650" MinWidth="560" MinHeight="560"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource AppBackgroundBrush}">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Border Style="{StaticResource CardStyle}" Padding="14" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="ALLOWLIST CHANGE MAP" Style="{StaticResource SectionTitleStyle}" />
                <TextBlock Text="Cochez uniquement les cartes réellement installées et que vous autorisez à charger sur CE serveur. « Supportée » ne signifie jamais « installée »."
                           Foreground="{StaticResource WarningBrush}" FontSize="10" Margin="0,7,0,0" TextWrapping="Wrap" />
            </StackPanel>
        </Border>
        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="14">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="MapsList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" Margin="0,6" FontSize="12">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding DisplayName}" Width="250" />
                                    <TextBlock Text="{Binding Code}" Foreground="{StaticResource TextMutedBrush}" />
                                </StackPanel>
                            </CheckBox>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>
        <Grid Grid.Row="2" Margin="0,10,0,0">
            <StackPanel Orientation="Horizontal">
                <Button Content="TOUT COCHER" Style="{StaticResource SecondaryButtonStyle}" Padding="10,6" Margin="0,0,8,0" Click="SelectAll_Click" />
                <Button Content="TOUT DÉCOCHER" Style="{StaticResource SecondaryButtonStyle}" Padding="10,6" Click="SelectNone_Click" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="ANNULER" Style="{StaticResource SecondaryButtonStyle}" Padding="11,6" Margin="0,0,8,0" Click="Cancel_Click" />
                <Button Content="VALIDER" Style="{StaticResource PrimaryButtonStyle}" Padding="12,6" Click="Validate_Click" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
