<UserControl x:Class="PinteMod.ControlCenter.Views.PlayerChatView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource CardStyle}" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="CHAT JOUEURS" Style="{StaticResource SectionTitleStyle}" />
                    <TextBlock Text="Uniquement les messages normaux écrits en game. JOIN, LEAVE, COMMAND, RANKS et événements système ne sont pas affichés."
                               Foreground="{StaticResource TextSecondaryBrush}" FontSize="10" TextWrapping="Wrap" Margin="0,7,18,0" />
                    <TextBlock Text="{Binding SourceSummary}" Foreground="{StaticResource TextMutedBrush}" FontSize="9" TextWrapping="Wrap" Margin="0,8,18,0" />
                    <TextBlock Text="{Binding SourceLabel}" Foreground="{DynamicResource AccentBrightBrush}" FontSize="9" Margin="0,3,18,0" />
                    <TextBlock Text="{Binding FreshnessSummary}" Foreground="{StaticResource TextMutedBrush}" FontSize="9" Margin="0,3,18,0" />
                </StackPanel>
                <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Ellipse Width="7" Height="7" Fill="{DynamicResource AccentBrush}" Margin="0,0,6,0" />
                        <TextBlock Text="{Binding CaptureStateLabel}" Style="{StaticResource EyebrowTextStyle}" />
                    </StackPanel>
                    <TextBlock Text="{Binding MessageCountLabel}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="10"
                               HorizontalAlignment="Right" Margin="0,10,0,0" />
                    <Button Content="EFFACER LE CHAT" Command="{Binding ClearChatCommand}"
                            Style="{StaticResource SecondaryButtonStyle}" Padding="11,6" Margin="0,12,0,0"
                            ToolTip="Efface uniquement l’historique local du Control Center. Les logs serveur restent intacts." />
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource CardStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Margin="0,0,0,6">
                    <TextBlock Text="HISTORIQUE" Style="{StaticResource SectionTitleStyle}" />
                    <TextBlock Text="READ-ONLY · PERSISTANT PAR PROFIL" Style="{StaticResource EyebrowTextStyle}" HorizontalAlignment="Right" />
                </Grid>
                <TextBlock Grid.Row="1" Text="{Binding StatusMessage}" Foreground="{StaticResource TextMutedBrush}" FontSize="9"
                           HorizontalAlignment="Right" Margin="0,0,0,8" />

                <ScrollViewer x:Name="ChatScroller" Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              Visibility="{Binding HasMessages, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <ItemsControl ItemsSource="{Binding Messages}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <Border Background="{DynamicResource AccentSoftBrush}" CornerRadius="4" Padding="10,6" Margin="0,10,0,5"
                                            Visibility="{Binding ShowMapSeparator, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <TextBlock Text="{Binding MapSeparatorText}"
                                                   Foreground="{DynamicResource AccentBrightBrush}" FontSize="10" FontWeight="SemiBold"
                                                   HorizontalAlignment="Center" />
                                    </Border>
                                    <Border BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,0,0,1" Padding="2,10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="76" />
                                                <ColumnDefinition Width="170" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Time}" Foreground="{StaticResource TextMutedBrush}" FontSize="10" />
                                            <TextBlock Grid.Column="1" Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="11"
                                                       TextTrimming="CharacterEllipsis" Margin="0,0,12,0" />
                                            <TextBlock Grid.Column="2" Text="{Binding Message}" Foreground="{StaticResource TextSecondaryBrush}"
                                                       FontSize="11" TextWrapping="Wrap" />
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <StackPanel Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Center"
                            Visibility="{Binding HasMessages, Converter={StaticResource InvertedBooleanToVisibilityConverter}}">
                    <TextBlock Text="AUCUN MESSAGE JOUEUR" Style="{StaticResource EyebrowTextStyle}" HorizontalAlignment="Center" />
                    <TextBlock Text="Les prochains messages normaux écrits en game apparaîtront ici."
                               Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,7,0,0" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
