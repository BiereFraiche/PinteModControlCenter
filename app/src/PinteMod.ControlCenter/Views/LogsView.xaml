<UserControl x:Class="PinteMod.ControlCenter.Views.LogsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:PinteMod.ControlCenter.Controls">
    <Grid Margin="20">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource CardStyle}" Margin="0,0,0,14">
            <controls:ResponsiveUniformGrid MinItemWidth="430" MaxColumns="2">
                <StackPanel Margin="0,0,14,10">
                    <TextBlock Text="FILTRES D’ÉVÉNEMENTS" Style="{StaticResource SectionTitleStyle}" />
                    <ItemsControl ItemsSource="{Binding Filters}" Margin="0,10,0,0">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <RadioButton Content="{Binding Key}" GroupName="LogFilters" Style="{StaticResource FilterRadioStyle}"
                                             IsChecked="{Binding IsSelected, Mode=OneWay}"
                                             Command="{Binding DataContext.SelectFilterCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                             CommandParameter="{Binding}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
                <StackPanel Margin="0,0,0,10">
                    <TextBlock Text="RECHERCHE LOCALE" Style="{StaticResource EyebrowTextStyle}" />
                    <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Margin="0,9,0,0" ToolTip="{Binding SearchToolTip}" />
                </StackPanel>
            </controls:ResponsiveUniformGrid>
        </Border>

        <Border Grid.Row="1" Background="{StaticResource AccentSoftBrush}" BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1" CornerRadius="6" Padding="12,9" Margin="0,0,0,14">
            <Grid>
                <TextBlock Foreground="{StaticResource TextSecondaryBrush}" FontSize="10">
                    <Run Text="Filtre actif : " /><Run Text="{Binding SelectedFilter, Mode=OneWay}" FontWeight="Bold" Foreground="{StaticResource AccentBrightBrush}" />
                    <Run Text=" · " /><Run Text="{Binding SourceSummary, Mode=OneWay}" />
                </TextBlock>
                <TextBlock Text="READ-ONLY" Style="{StaticResource EyebrowTextStyle}" HorizontalAlignment="Right" />
            </Grid>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource CardStyle}">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <Grid Margin="0,0,0,10">
                    <TextBlock Text="LIVE CONSOLE" Style="{StaticResource SectionTitleStyle}" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Ellipse Width="7" Height="7" Fill="{StaticResource AccentBrush}" Margin="0,0,6,0" />
                        <TextBlock Text="{Binding DisplayStateLabel}" Style="{StaticResource EyebrowTextStyle}" />
                    </StackPanel>
                </Grid>
                <Grid Grid.Row="0" Margin="0,20,0,10">
                    <StackPanel Margin="0,0,300,0">
                        <TextBlock Text="{Binding FreshnessSummary}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="9" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding SourceLabel}" Foreground="{StaticResource AccentBrightBrush}" FontSize="9" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding ClipboardStatus}" Foreground="{StaticResource TextMutedBrush}" FontSize="9" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                        <Button Content="COPIER LE FILTRE" Command="{Binding CopyVisibleEventsCommand}"
                                Style="{StaticResource SecondaryButtonStyle}" Padding="10,5" Margin="0,0,8,0"
                                ToolTip="Copie uniquement les événements actuellement visibles et déjà neutralisés" />
                        <CheckBox Content="Auto-scroll" IsChecked="{Binding AutoScrollEnabled, Mode=TwoWay}" Margin="0,0,12,0" />
                        <Button Content="{Binding PauseButtonLabel}" Command="{Binding ToggleDisplayPauseCommand}" Padding="10,5" />
                    </StackPanel>
                </Grid>
                <ScrollViewer x:Name="EventScroller" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              Visibility="{Binding HasEvents, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <ItemsControl ItemsSource="{Binding Events}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,0,0,1" Padding="0,12">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="74" /><ColumnDefinition Width="110" /><ColumnDefinition Width="160" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Time}" Foreground="{StaticResource TextMutedBrush}" FontSize="10" />
                                        <Border Grid.Column="1" Background="{StaticResource AccentSoftBrush}" CornerRadius="3" Padding="7,3" HorizontalAlignment="Left" VerticalAlignment="Top">
                                            <TextBlock Text="{Binding Category}" FontSize="9" FontWeight="Bold" Foreground="{Binding Severity, Converter={StaticResource StatusBrushConverter}}" />
                                        </Border>
                                        <TextBlock Grid.Column="2" Text="{Binding Title}" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,10,0" />
                                        <TextBlock Grid.Column="3" Text="{Binding Details}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="10" TextWrapping="Wrap" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                            Visibility="{Binding HasEvents, Converter={StaticResource InvertedBooleanToVisibilityConverter}}">
                    <TextBlock Text="AUCUN ÉVÉNEMENT" Style="{StaticResource EyebrowTextStyle}" HorizontalAlignment="Center" />
                    <TextBlock Text="Aucun résultat ne correspond au filtre et à la recherche."
                               Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,7,0,0" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
